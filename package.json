{
  "name": "episki",
  "version": "1.0.0",
  "description": "episki desktop app",
  "author": "episki <hello@episki.com>",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "postinstall": "install-electron",
    "compile": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "bun run compile && unset ELECTRON_RUN_AS_NODE && electron .",
    "build": "bun run compile && electron-builder --publish never",
    "build:mac": "bun run compile && electron-builder --mac --publish never",
    "build:win": "bun run compile && electron-builder --win --publish never",
    "build:linux": "bun run compile && electron-builder --linux --publish never",
    "release": "bun run compile && electron-builder --publish always",
    "lint": "eslint",
    "lintfix": "eslint --fix"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.2",
    "dotenv": "^18.0.8",
    "electron": "^44.8.0",
    "electron-builder": "^26.17.0",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
