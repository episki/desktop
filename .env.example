# Development only. A packaged app does not read .env -- it is launched with no
# meaningful working directory, and always targets production.

# Override the web app URL while working on the desktop shell locally.
# Ignored in packaged builds, which always use https://app.episki.com.
# APP_URL=http://localhost:3000

# Force the auto-updater on in development, against dev-app-update.yml.
# EPISKI_TEST_UPDATER=1
